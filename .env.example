# AI Realms — copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./airealms.db
AIREALMS_GAME_BASE=http://localhost:8000/api/v1
AIREALMS_LLM_BASE=https://your-openai-compatible-router.example/v1
AIREALMS_LLM_MODEL=your-model-name
# AIREALMS_LLM_KEY=sk-your-key  # required with AIREALMS_LLM_BASE to enable the LLM brain
# Optional objective override (default: server GET /meta/goals).
# AIREALMS_GOAL=Reach level 5 as fast as possible; prefer combat over chat.
