# AI Realms — copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./airealms.db
AIREALMS_GAME_BASE=http://localhost:8765/api/v1
AIREALMS_LLM_BASE=https://your-openai-compatible-router.example/v1
AIREALMS_LLM_MODEL=your-model-name
AIREALMS_LLM_PROVIDER=your-provider-name
# AIREALMS_LLM_KEY=sk-your-key  # required with AIREALMS_LLM_BASE to enable the LLM brain
# Optional objective override (default: server GET /meta/goals).
# AIREALMS_GOAL=Reach level 5 as fast as possible; prefer combat over chat.
# Short-term memory: compact past turns fed to the LLM brain (0 disables).
# AIREALMS_HISTORY=3
# Verbose agent log: 1 prints full server envelopes each turn.
# AIREALMS_VERBOSE=0
# Live HUD (enabled by default; `play.py --no-view` disables): poll seconds and local server port.
# AIREALMS_VIEW_REFRESH=1
# AIREALMS_VIEW_PORT=0
# Terminal art is hidden by default; set 1 or pass `play.py --art` to show it.
# AIREALMS_ART=0
